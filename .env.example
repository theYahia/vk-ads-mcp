# VK Ads MCP — переменные окружения
# В проде MCP-клиент (Claude Desktop / Claude Code) передаёт их через "env" в своём конфиге.
# Этот файл нужен только для локального запуска (npm run dev).

# Обязательно: Bearer access_token VK Ads API.
VK_ADS_TOKEN=

# Опционально: авто-обновление истёкшего access_token (живёт 1 день).
# Если заданы все три — на 401 сервер сам обновит токен через grant_type=refresh_token.
# VK_ADS_CLIENT_ID=
# VK_ADS_CLIENT_SECRET=
# VK_ADS_REFRESH_TOKEN=
